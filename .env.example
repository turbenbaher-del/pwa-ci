# Адрес прокси, который ходит в ДБО (см. проект centrinvest-proxy).
VITE_PROXY_URL=https://your-proxy.up.railway.app

# Токен доступа к прокси (PROXY_TOKEN на стороне сервера).
#
# ВАЖНО: любое значение здесь попадает в собранный JS и видно любому, кто откроет
# исходники страницы. Токен закрывает прокси от случайного обнаружения по адресу,
# но не от того, кто уже открыл приложение. Полноценная защита возможна только
# когда каждый пользователь входит своими логином и паролем ДБО.
VITE_PROXY_TOKEN=

# База деплоя: '/pwa-ci/' для GitHub Pages, '/' для своего домена.
VITE_BASE=/pwa-ci/
